   "t1": 34.269999999999996,
   "breaks": [
    [
     0,
     30.049999999999997,
     30.28
    ],
    [
     1,
     31.879999999999995,
     32.199999999999996
    ]
   ]
  },
  {
   "p": 2,
   "s": 2,
   "text": "Ils tombent dans une goulotte, puis dans le creuset.",
   "t0": 35.05,
   "t1": 37.59,
   "breaks": [
    [
     0,
     36.39,
     36.629999999999995
    ]
   ]
  },
  {
   "p": 2,
   "s": 3,
   "text": "Pourquoi tomber ?",
   "t0": 38.489999999999995,
   "t1": 39.23,
   "breaks": []
  },
  {
   "p": 2,
   "s": 4,
   "text": "Pour qu'il n'y ait jamais de chemin entre le feu et le réservoir.",
   "t0": 40.07999999999999,
   "t1": 43.38999999999999,
   "breaks": []
  },
  {
   "p": 2,
   "s": 5,
   "text": "Le feu ne peut pas remonter.",
   "t0": 44.13999999999999,
   "t1": 45.64999999999999,
   "breaks": []
  },
  {
   "p": 3,
   "s": 0,
   "text": "Pour allumer, une bougie électrique chauffe jusqu'à rougir.",
