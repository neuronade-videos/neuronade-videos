   "t1": 8.809999999999999,
   "breaks": [
    [
     0,
     8.07,
     8.309999999999999
    ]
   ]
  },
  {
   "p": 0,
   "s": 4,
   "text": "Regarde comment il fait.",
   "t0": 9.559999999999999,
   "t1": 10.66,
   "breaks": []
  },
  {
   "p": 1,
   "s": 0,
   "text": "Un poêle à granulés, c'est un réservoir, une vis, un creuset, et deux ventilateurs.",
   "t0": 12.459999999999999,
   "t1": 18.29,
   "breaks": [
    [
     0,
     13.569999999999999,
     13.819999999999999
    ],
    [
