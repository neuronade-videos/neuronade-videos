   "t1": 4.01,
   "breaks": []
  },
  {
   "p": 0,
   "s": 2,
   "text": "Un sèche-cheveux caché dans le ventre.",
   "t0": 4.76,
   "t1": 6.75,
   "breaks": []
  },
  {
   "p": 0,
   "s": 3,
   "text": "Enfin… presque.",
