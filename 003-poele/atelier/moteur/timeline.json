     16.11
    ],
    [
     3,
     16.799999999999997,
     17.119999999999997
    ]
   ]
  },
  {
   "p": 1,
   "s": 1,
   "text": "Les granulés, c'est de la sciure de bois compressée.",
   "t0": 19.11,
   "t1": 21.86,
   "breaks": [
    [
     0,
     19.839999999999996,
     20.019999999999996
    ]
   ]
  },
  {
   "p": 1,
   "s": 2,
   "text": "Un kilo contient environ cinq kilowattheures.",
   "t0": 22.639999999999997,
   "t1": 25.11,
   "breaks": []
  },
  {
   "p": 2,
   "s": 0,
   "text": "Tout part du réservoir.",
   "t0": 26.91,
   "t1": 28.13,
   "breaks": []
  },
  {
   "p": 2,
   "s": 1,
   "text": "Une vis sans fin, entraînée par un petit moteur, pousse les granulés dose par dose.",
